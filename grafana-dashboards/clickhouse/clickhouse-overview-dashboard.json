            "expr": "0 * max by (k8s_cluster_name, node) (longhorn_volume_capacity_bytes{k8s_cluster_name=~\"$kubernetes_cluster\",pvc_namespace=~\"$namespace\",pvc=~\"${pvc:regex}\"}) + ${disk_iops_limit:raw}",
